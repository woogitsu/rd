{
  "name": "rd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rd --local",
    "db:migrate:remote": "wrangler d1 migrations apply rd --remote",
    "dev:import": "vite import",
    "build:import": "vite build import --outDir ../dist/import",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
