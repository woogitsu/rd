{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci"
  },
  "deploy": {
    "startCommand": "node scripts/email-worker.js",
    "cronSchedule": "15 * * * *",
    "restartPolicyType": "NEVER",
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    }
  }
}
