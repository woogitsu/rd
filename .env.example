# Copy locally. Never put real values in git.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
# Docelowo: prywatny PostgreSQL Railway. Nie wpisuj poświadczeń do repo.
DATABASE_URL=
# PORT jest ustawiany przez Railway; lokalnie można użyć 3000.
PORT=3000
# Prywatny Railway Storage Bucket (docs/DOCUMENTS.md). Wartości wyłącznie jako
# zmienne/secrets Railway; lokalne testy używają magazynu w pamięci.
BUCKET_ENDPOINT=
BUCKET_REGION=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# virtual (domyślnie) albo path — zgodnie z zakładką Credentials bucketu.
BUCKET_URL_STYLE=
# Limit pliku w bajtach; domyślnie 10 MiB, najwyżej 25 MiB.
DOCUMENT_MAX_BYTES=
# Set BREVO_API_KEY only as a Railway service secret (e-mail worker), never a real value here.
BREVO_API_KEY=
# Sender domain and address require verification with Brevo.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Rada Rodziców Szkoły Polskiej
# Shared secret for POST /api/email/webhooks/brevo (min. 32 chars), Railway secret only.
BREVO_WEBHOOK_SECRET=
# E-mail queue (docs/EMAIL.md). Sending stays disabled unless exactly "true".
EMAIL_SENDING_ENABLED=
# Outside production only these technical addresses may receive mail, e.g. *@example.invalid
EMAIL_TEST_ALLOWLIST=
EMAIL_DAILY_LIMIT=
EMAIL_DAILY_RESERVED=
EMAIL_CAMPAIGN_MIN_DAYS=
EMAIL_CAMPAIGN_MIN_DAILY=
EMAIL_BATCH_SIZE=
EMAIL_MAX_ATTEMPTS=
EMAIL_BREAKER_UNCERTAIN=
# #140 pkt 5: kod weryfikacyjny na nowy adres z wniosku rodzica (aplikacja i worker). Wyłącznie "true" włącza;
# dodatkowo wymaga szablonu zatwierdzonego przez zarząd i opublikowanej informacji o przetwarzaniu danych.
GUARDIAN_VERIFY_EMAIL_ENABLED=
# MFA (issue #3): 32-bajtowy klucz AES-256-GCM (64 znaki hex lub base64) do szyfrowania sekretów TOTP.
# Ustaw wyłącznie jako sekret usługi Railway; zmiana klucza unieważnia zapisane czynniki.
MFA_ENCRYPTION_KEY=
# Logowanie hasłem (issue #3). Role z obowiązkowym MFA, oddzielone przecinkami;
# brak zmiennej = admin,board,treasurer; pusty ciąg = bez obowiązku zapisu MFA.
MFA_REQUIRED_ROLES=
# Koszt scrypt jako log2(N), 15–20; brak = 17 (OWASP). Zmiana nie unieważnia haseł.
SCRYPT_COST_LOG2=
# Kontekstowe rdzenie słabych haseł (#196), oddzielone przecinkami, np. nazwa szkoły i gminy.
# Hasło = rdzeń + same cyfry/znaki jest odrzucane (password_common). Brak = bez dodatkowych rdzeni.
PASSWORD_CONTEXT_STEMS=
# 1 = serwer stoi za zaufanym proxy (Railway): adres klienta z X-Forwarded-For.
TRUST_PROXY=
# Ogólny limiter żądań (#126, w pamięci procesu; docs/AUTH.md). Progi na minutę; puste = domyślne
# (public 300, webhook 600, sesja 1200, suma sesji z jednego adresu 3000), 0 = klasa bez limitu. Równoczesne kosztowne trasy na sesję: 2.
RATE_LIMIT_PUBLIC_PER_MIN=
RATE_LIMIT_WEBHOOK_PER_MIN=
RATE_LIMIT_SESSION_PER_MIN=
RATE_LIMIT_SESSION_ADDRESS_PER_MIN=
RATE_LIMIT_HEAVY_CONCURRENCY=
# 1 = wyłącza ogólny limiter. Opóźnienie (ms) od 10. błędu logowania na sam adres e-mail; brak = 1000/2000, 0 = bez opóźnienia.
RATE_LIMIT_DISABLED=
LOGIN_EMAIL_DELAY_MS=
# Próg „konto pod presją” (#126): błędne próby na jedno konto w 15 min, od których administrator dostaje sygnał (ops-status + audyt); 6–1000, brak/błąd = 15.
LOGIN_PRESSURE_THRESHOLD=
# Import wyciągu CODA / CAMT.053 (issue #105, docs/RECONCILIATION.md). Klucz HMAC (min. 32 znaki)
# skrótów identyfikatorów transakcji i plików — wyłącznie jako sekret Railway; zmiana klucza
# wyłącza wykrywanie wcześniej zaimportowanych ruchów. Rachunek Rady po decyzji D-13.
BANK_TRANSACTION_HASH_KEY=
RECONCILIATION_BANK_ACCOUNT_IBAN=
# D-09 (#137, wariant b): 1 albo true = rola audit (Komisja Rewizyjna) czyta księgę roku i dokumenty finansowe (tylko odczyt, MFA, rok przydziału).
# Brak = wyłączone (audit czyta wyłącznie raport KR i prowadzi uwagi). Opis: docs/AUTHORIZATION.md, „Zakres roli audit”.
AUDIT_LEDGER_READ=
