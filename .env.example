# Copy locally. Never put real values in git.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
# Docelowo: prywatny PostgreSQL Railway. Nie wpisuj poświadczeń do repo.
DATABASE_URL=
# PORT jest ustawiany przez Railway; lokalnie można użyć 3000.
PORT=3000
# Set BREVO_API_KEY only as a Railway service secret, not in this file.
# Sender domain and address require verification with Brevo.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Rada Rodziców Szkoły Polskiej
