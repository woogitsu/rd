{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci"
  },
  "deploy": {
    "startCommand": "node scripts/restore-drill.js",
    "cronSchedule": "43 4 * * 1",
    "restartPolicyType": "NEVER",
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    }
  }
}
